<RCC>
    <qresource prefix="/debugger">
        <file alias="add">icons/plus.png</file>
        <file alias="breakpoint">icons/debug-break.png</file>
        <file alias="cancel">icons/cross.png</file>
        <file alias="cctv-camera">icons/cctv-camera.png</file>
        <file alias="connect">icons/debug-attach.png</file>
        <file alias="debugger">icons/debugger.png</file>
        <file alias="disconnect">icons/debug-detach.png</file>
        <file alias="menu">icons/menu.png</file>
        <file alias="pause">icons/pause.png</file>
        <file alias="remove">icons/minus.png</file>
        <file alias="restart">icons/restart.png</file>
        <file alias="resume">icons/continue.png</file>
        <file alias="resume-reverse">icons/continue-reverse.png</file>
        <file alias="settings">icons/settings.png</file>
        <file alias="start">icons/start.png</file>
        <file alias="step-back">icons/step-back.png</file>
        <file alias="step-into">icons/step-into.png</file>
        <file alias="step-into-reverse">icons/step-into-reverse.png</file>
        <file alias="step-out">icons/step-out.png</file>
        <file alias="step-out-reverse">icons/step-out-reverse.png</file>
        <file alias="step-over">icons/step-over.png</file>
        <file alias="stop">icons/stop.png</file>
        <file alias="ttd-memory">icons/debug-ttd-memory.png</file>
        <file alias="ttd-calls">icons/debug-ttd-call.png</file>
        <file alias="ttd-timestamp">icons/step-between.png</file>
        <file alias="ttd-events">icons/debug-ttd-event.png</file>
        <file alias="ttd-back">icons/debug-ttd-back.png</file>
        <file alias="ttd-forward">icons/debug-ttd-forward.png</file>
    </qresource>
</RCC>
