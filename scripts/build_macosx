#!/bin/bash
set -e
export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH
export PYTHONUNBUFFERED=1
# An inherited environment must not override the project-local interpreter.
unset VIRTUAL_ENV CONDA_PREFIX UV_PROJECT_ENVIRONMENT
ci_python=$(bash "$(dirname "$0")/select_ci_python.sh")
echo "Selected CI Python: $ci_python"
"$ci_python" --version
uv sync --locked --python "$ci_python"
uv run --locked --python "$ci_python" python scripts/build.py "$@"
