# Keep executable code and auxiliary data in their standard bundle locations.
file(READ "${GDB_SOURCE}/build-manifest.json" manifest)
function(verify_gdb_copy relative destination)
    string(JSON expected_hash GET "${manifest}" signed_binary_sha256 "${relative}")
    file(SHA256 "${destination}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "GDB artifact hash mismatch: ${relative}")
    endif()
    execute_process(COMMAND codesign --verify --strict "${destination}"
        COMMAND_ERROR_IS_FATAL ANY)
endfunction()
file(MAKE_DIRECTORY "${CONTENTS}/MacOS/plugins" "${CONTENTS}/Resources/gdb")
file(COPY "${GDB_SOURCE}/bin/gdb" DESTINATION "${CONTENTS}/MacOS/plugins")
verify_gdb_copy("bin/gdb" "${CONTENTS}/MacOS/plugins/gdb")
file(COPY "${GDB_SOURCE}/share/gdb/" DESTINATION "${CONTENTS}/Resources/gdb")
foreach(resource COPYING build-manifest.json)
    if(EXISTS "${GDB_SOURCE}/${resource}")
        file(COPY "${GDB_SOURCE}/${resource}" DESTINATION "${CONTENTS}/Resources/gdb")
    endif()
endforeach()
